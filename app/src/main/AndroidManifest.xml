<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <queries>
        <intent>
            <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
        </intent>
    </queries>

    <!--
        TV only. Leanback is now required, which makes Google Play filter the app to
        Android TV devices. Touchscreen and faketouch stay optional because TVs have
        neither; declaring them as not required is what keeps TV devices eligible.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.faketouch"
        android:required="false" />

    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
        Network shares. Nothing else in the app talks to the network. From Android 17 on,
        reaching a device on the local network needs its own runtime permission on top of
        INTERNET, which is what a share on the home network is.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Handing an APK to the package installer. The installation itself is still confirmed
        by the user, and Android additionally asks once whether this app may act as a source.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".LuckyFilesTVApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:banner="@mipmap/tv_banner"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.LuckyFilesTV"
        tools:targetApi="33">

        <service
            android:name=".data.transfer.FileTransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            Keeps the process in the foreground while another app reads a file from a share.
            Without it Android cuts the network of the backgrounded process and playback in
            an external player stalls.
        -->
        <service
            android:name=".data.provider.RemoteAccessService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            Lets AppCompatDelegate persist and restore the selected app language below API 33.
            The service is never started, it only carries the meta-data; appcompat reads the
            stored locale when the first activity attaches, so no recreation flash on cold start.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <provider
            android:name=".data.provider.FileContentProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />

        <provider
            android:name=".data.provider.FileDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <!--
                LEANBACK_LAUNCHER only. The regular LAUNCHER category was removed so the
                app no longer shows up in a phone or tablet launcher.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DocumentPickerActivity"
            android:exported="false" />

        <activity-alias
            android:name=".SystemDocumentPicker"
            android:targetActivity=".DocumentPickerActivity"
            android:enabled="@bool/system_document_picker_enabled"
            android:exported="true">

            <intent-filter android:priority="120">
                <action android:name="android.intent.action.OPEN_DOCUMENT" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />

                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter android:priority="120">
                <action android:name="android.intent.action.CREATE_DOCUMENT" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />

                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter android:priority="120">
                <action android:name="android.intent.action.GET_CONTENT" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.OPENABLE" />

                <data android:mimeType="*/*" />
            </intent-filter>

            <intent-filter android:priority="120">
                <action android:name="android.intent.action.OPEN_DOCUMENT_TREE" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity-alias>

    </application>

</manifest>
